{
  "name": "expo-app",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "vibekit": {
    "build": "expo"
  },
  "scripts": {
    "start": "node server.js",
    "build": "expo export --platform all --no-bytecode --output-dir dist-export && expo config --json --type public > dist-export/expo-config.json"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "expo": "~58.0.16",
    "expo-constants": "~58.0.12",
    "expo-linking": "~58.0.13",
    "expo-router": "~58.0.24",
    "expo-secure-store": "~58.0.2",
    "expo-status-bar": "~58.0.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-web": "~0.21.4"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "typescript": "~6.0.3"
  }
}
